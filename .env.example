# TibaDirect environment template.
# Copy to .env (gitignored) and adjust. Never commit real credentials.
# Values below are development placeholders only. Production refuses to start
# if SECRET_KEY, DATA_ENCRYPTION_KEY or HASH_PEPPER are left at these defaults.

# --- Application ---
APP_ENV=development
SECRET_KEY=change-me
# Where the web app is reached: the Vite dev server (make web) is 5173; the Docker image serves it from the API on 5000.
APP_BASE_URL=http://localhost:5173
DEMO_BANNER=true

# --- Database ---
DATABASE_URL=postgresql+psycopg://tiba:tiba@localhost:5432/tibadirect
TEST_DATABASE_URL=postgresql+psycopg://tiba:tiba@localhost:5432/tibadirect_test

# --- Redis (jobs and rate limits) ---
REDIS_URL=redis://localhost:6379/0

# --- Background jobs ---
# Workers need true. false runs each job inline when it is enqueued (tests use this).
JOBS_ASYNC=true

# --- Encryption and hashing ---
# DATA_ENCRYPTION_KEY is base64 of 32 random bytes (AES-256-GCM).
# Generate a real one with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=
HASH_PEPPER=change-me-too

# --- Object storage (MinIO locally, R2 or S3 in production) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=tibadirect-uploads
S3_ACCESS_KEY_ID=tibadirect-dev
S3_SECRET_ACCESS_KEY=tibadirect-dev-secret
S3_REGION=us-east-1
# The local MinIO's own login (docker-compose uses the same defaults). Production refuses these.
S3_ACCESS_KEY_ID=tibadirect-dev
S3_SECRET_ACCESS_KEY=tibadirect-dev-secret
# Set when browsers reach the bucket at a different address than the server does.
S3_PUBLIC_ENDPOINT_URL=
# AES256 asks S3 to encrypt objects at rest; leave empty for MinIO, which has no key service here.
S3_SERVER_SIDE_ENCRYPTION=

# --- Email (Mailpit locally: SMTP 1025, web UI 8025) ---
# smtp sends through the server below; memory keeps messages in the process (tests only).
MAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@tibadirect.test

# --- PayPal (sandbox only) ---
# mock = in-process fake used by tests and offline runs
PAYPAL_MODE=mock
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# JSON map {register_code: {"client_id": "...", "client_secret": "..."}} for hospital invoicing
HOSPITAL_PAYPAL_CREDENTIALS={}
# The collector account's PayPal email: the person a hospital's invoice is addressed to
PAYPAL_COLLECTOR_EMAIL=
# Offline fake (PAYPAL_MODE=mock): redis shares orders between the API and the worker, memory does not
PAYPAL_MOCK_STORE=redis
PAYPAL_MOCK_FEE_BPS=290
PAYPAL_MOCK_FEE_FIXED_USD_MINOR=30
PAYPAL_MOCK_AUTO_APPROVE=true

# --- Language model provider (optional; empty key = local-only fallbacks) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- FX and money policy ---
FX_PROVIDER=static
FX_STATIC_USD_KES=129.00
BUFFER_BPS_DEFAULT=500
TRANCHE_MIN_KES=20000
TRANCHE_FRACTION_BPS=2500
ESTIMATE_SETTLEMENT_CAP_BPS=8000
REFUND_MIN_USD_MINOR=100
FOLLOW_UP_HOLD_DAYS=14
TWO_PERSON_THRESHOLD_KES=200000

# --- Demo data ---
# Where the synthetic dataset lives (default: data/synthetic in the repository).
SYNTHETIC_DATA_DIR=
# Optional JSON map {register_code: paypal sandbox email} for the seeded hospitals' payouts.
SEED_HOSPITAL_PAYOUT_EMAILS={}

# --- Privacy and features ---
RAW_DOC_RETENTION_HOURS=24
AGENT_ENABLED=false
APPEAL_CHECKER_ENABLED=true
APPEAL_CHECKER_USE_LLM=false

# --- Web ---
# Browser origins allowed to call the API (comma separated). Empty uses the local Vite server in
# development and nothing in production, where the app and the API share one origin.
CORS_ORIGINS=
# Number of reverse proxies in front of the app (1 on Render) so client addresses are real.
PROXY_FIX_COUNT=0

# --- Local docker-compose host ports (change if a port is already in use) ---
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=5000
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
